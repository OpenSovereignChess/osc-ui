---
import Layout from "./_Layout.astro";
import Button from "../app/components/Button.tsx";
import { read as readBoardFen } from "../game/rules/fen.ts";
import "../game/ui/board/board.css";
import "../../../../packages/board-solid/src/styles/piece.css";
import "../../../../packages/board-solid/src/styles/piece.generated.css";

const boardFiles = "abcdefghijklmnop";
const heroPieces = Array.from(readBoardFen().entries()).map(([key, piece]) => {
  const file = key.slice(0, 1);
  const rank = Number(key.slice(1));

  return {
    key,
    piece,
    x: boardFiles.indexOf(file),
    y: 16 - rank,
  };
});
---

<Layout title="Play Sovereign Chess">
  <section class="home-hero landing-section--solid">
    <div class="site-inner home-hero__grid">
      <div class="home-hero__copy">
        <p class="eyebrow">Sovereign Chess online</p>
        <h1>Play Sovereign Chess online with a friend.</h1>
        <p>
          Create a game, share the invite link, and play Sovereign Chess with a
          friend in your browser. No sign-ups or downloads required.
        </p>
        <div class="button-row">
          <Button variant="primary" href="/play">Start a match</Button>
        </div>
      </div>
      <div
        class="home-board-card ui-panel"
        aria-label="16 by 16 Sovereign Chess board preview"
      >
        <div class="home-board-meta">
          <span>Sovereign chess board</span>
          <span>Initial setup</span>
        </div>
        <div
          class="home-board-preview board"
          role="img"
          aria-label="Sovereign Chess 16 by 16 board with colored regimes and starting pieces"
        >
          {
            heroPieces.map(({ key, piece, x, y }) => (
              <span
                class={`home-hero-piece piece ${piece.role} ${piece.color}`}
                style={`--hero-piece-x: ${x}; --hero-piece-y: ${y};`}
                aria-hidden="true"
                data-square={key}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="landing-band landing-band--pattern">
    <div class="site-inner landing-cta">
      <div>
        <p class="eyebrow">Official game</p>
        <h2>Visit the official Sovereign Chess site.</h2>
        <p>
          Learn more about the board game from Infinite Pi Games, the creators
          of Sovereign Chess.
        </p>
      </div>
      <Button
        href="https://www.infinitepigames.com/sovereign-chess"
        target="_blank"
        rel="noopener"
      >
        Visit official game site
      </Button>
    </div>
  </section>

  <section id="contact" class="contact-band">
    <div class="site-inner landing-cta">
      <div>
        <p>
          Questions or feedback? Email us at
          <a href="mailto:support@playsovereignchess.com">
            support@playsovereignchess.com</a
          >.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .home-hero {
    border-bottom: 1px solid var(--line);
    background-color: var(--panel);
    padding: clamp(28px, 6vw, 72px) clamp(16px, 4vw, 56px);
  }

  .landing-band {
    width: 100%;
    border-bottom: 1px solid var(--line);
    padding: clamp(40px, 7vw, 84px) clamp(16px, 4vw, 56px);
  }

  .landing-band--solid {
    background-color: var(--panel);
    background-image: none;
  }

  .landing-band--pattern {
    background:
      radial-gradient(rgba(28, 27, 26, 0.12) 0.7px, transparent 0.8px) 0 0 / 8px
        8px,
      var(--canvas);
  }

  .home-hero__grid {
    display: grid;
    align-items: center;
    gap: clamp(20px, 4vw, 48px);
    grid-template-columns: minmax(0, 1fr) minmax(280px, 500px);
  }

  .home-hero__copy h1 {
    max-width: 880px;
    margin: 0;
    font-size: clamp(42px, 8vw, 96px);
    line-height: 0.9;
    letter-spacing: -0.065em;
  }

  .home-hero__copy p:not(.eyebrow),
  .landing-cta p:not(.eyebrow) {
    max-width: 680px;
    margin: 16px 0 24px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
  }

  .home-board-card {
    /* 500px outer card leaves a 480px board image after card and board borders/padding: 30px × 16 squares. */
    width: min(100%, 500px);
    justify-self: end;
    padding: 8px;
  }

  /* Reuses the actual gameplay board background from apps/web/src/game/ui/board/board.css. */
  .home-board-preview.board {
    position: relative;
    inset: auto;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--line);
    background-size:
      var(--board-square-size) var(--board-square-size),
      var(--board-square-size) var(--board-square-size),
      cover;
    box-shadow: inset 0 0 0 0.5px #00000033;
  }

  .home-hero-piece.piece {
    transform: translate(
      calc(var(--hero-piece-x) * 100%),
      calc(var(--hero-piece-y) * 100%)
    );
  }

  .home-board-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    color: var(--muted);
    font: 800 12px/1 var(--font-mono);
    text-transform: uppercase;
  }

  .landing-cta {
    display: grid;
    align-items: center;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .landing-cta h2 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .landing-cta p:not(.eyebrow) {
    margin-bottom: 0;
  }

  .landing-cta .osc-button {
    justify-self: end;
  }

  .contact-band {
    padding: clamp(18px, 4vw, 48px);
  }

  .contact-band a:not(.osc-button) {
    color: var(--ink);
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .home-hero__grid,
    .landing-cta {
      grid-template-columns: 1fr;
    }

    .home-board-card,
    .landing-cta .osc-button {
      justify-self: start;
    }
  }
</style>
