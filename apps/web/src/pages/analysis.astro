---
import Layout from "./_Layout.astro";
import Button from "../app/components/Button.tsx";
import AnalysisBoard from "../game/analysis/AnalysisBoard.tsx";
---

<Layout
  title="Analysis | Play Sovereign Chess"
  showFooter={false}
  headerMode="board"
>
  <section class="app-workbench analysis-workbench">
    <div class="app-canvas analysis-canvas">
      <div class="analysis-toolbar ui-panel">
        <div>
          <p class="eyebrow">Analysis</p>
          <h1>Board analysis</h1>
        </div>
        <div class="button-row">
          <Button href="/editor">Set up board</Button>
          <Button disabled>Import PGN</Button>
        </div>
      </div>
      <div class="analysis-board">
        <AnalysisBoard client:only="solid-js" />
      </div>
    </div>
  </section>
</Layout>

<style>
  .analysis-workbench {
    grid-template-columns: minmax(0, 1fr);
  }

  .analysis-canvas {
    position: relative;
    grid-template-rows: auto 1fr;
    align-content: start;
    align-items: start;
    gap: 8px;
    padding: 8px;
  }

  .analysis-toolbar {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 12px;
  }

  .analysis-toolbar h1 {
    margin: 0;
    font-size: 24px;
    letter-spacing: -0.04em;
  }

  .analysis-board {
    width: 100%;
    min-width: 0;
  }

  @media (max-width: 1023px) {
    .analysis-toolbar {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
