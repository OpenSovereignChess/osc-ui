---
import Layout from "./_Layout.astro";
import ColorMatrix from "../app/components/ColorMatrix.astro";
---

<Layout title="Rules | Open Sovereign Chess">
  <section class="page-header site-section">
    <div class="site-inner">
      <p class="eyebrow">Interactive rules</p>
      <h1>
        Learn Sovereign Chess through controls, notation, and regime state.
      </h1>
      <p>
        The rules experience is structured as functional cards that can feed the
        contextual inspector in play and analysis shells.
      </p>
      <div class="button-row">
        <a class="button primary" href="/play">Open play shell</a>
        <a class="button" href="https://www.infinitepigames.com/sovereign-chess"
          >Official game site</a
        >
      </div>
    </div>
  </section>

  <section class="site-section">
    <div class="site-inner rules-layout">
      <aside class="ui-panel rules-matrix">
        <p class="eyebrow">Regime legend</p>
        <h2>Color + pattern + code</h2>
        <ColorMatrix />
      </aside>
      <div class="rules-grid">
        <article class="ui-panel">
          <span>01</span>
          <h2>Normal chess remains the base grammar</h2>
          <p>
            King safety, development, material, tempo, and square control still
            anchor position evaluation.
          </p>
        </article>
        <article class="ui-panel">
          <span>02</span>
          <h2>Ownership is visible as telemetry</h2>
          <p>
            Regime ownership appears in the matrix so players do not need to
            infer control from board colors alone.
          </p>
        </article>
        <article class="ui-panel">
          <span>03</span>
          <h2>The inspector explains mechanics in place</h2>
          <p>
            Rules appear in inline cards next to the board rather than
            interruptive modal overlays.
          </p>
        </article>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header .button-row {
    margin-top: 24px;
  }

  .rules-layout {
    display: grid;
    gap: 8px;
    grid-template-columns: minmax(280px, 352px) minmax(0, 1fr);
  }

  .rules-matrix {
    padding: 16px;
  }

  .rules-matrix h2,
  article h2 {
    margin: 0 0 16px;
    font-size: 16px;
  }

  .rules-grid {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  article {
    min-height: 260px;
    padding: 18px;
  }

  article span {
    color: var(--muted);
    font: 800 12px/1 var(--font-mono);
  }

  article h2 {
    margin: 56px 0 10px;
    font-size: 22px;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  article p {
    color: var(--muted);
    line-height: 1.52;
  }

  @media (max-width: 960px) {
    .rules-layout,
    .rules-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
