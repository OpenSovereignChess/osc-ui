---
import Layout from "./_Layout.astro";
import ProfileGames from "../app/profile/ProfileGames.tsx";
---

<Layout title="Profile | Play Sovereign Chess">
  <div class="profile-page site-inner">
    <h1>Profile</h1>
    <p class="profile-page__identity">
      Your games are linked to this browser. Switching devices or clearing site
      data may prevent you from returning to your seat.
    </p>
    <ProfileGames client:load />
  </div>
</Layout>
