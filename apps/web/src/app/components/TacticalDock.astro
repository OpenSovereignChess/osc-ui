---
import ColorMatrix from "./ColorMatrix.astro";

interface Props {
  title?: string;
}

const { title = "Tactical dock" } = Astro.props;
---

<aside class="tactical-dock" aria-label={title}>
  <section class="ui-panel tactical-dock__panel">
    <div class="panel-heading">
      <p class="eyebrow">Color control</p>
      <h2>12-regime matrix</h2>
    </div>
    <ColorMatrix />
  </section>

  <section class="ui-panel tactical-dock__panel">
    <div class="panel-heading panel-heading--row">
      <div>
        <p class="eyebrow">Notation</p>
        <h2>Move log</h2>
      </div>
      <div class="dock-filters" aria-label="Move log filters">
        <span>CAP</span><span>CTL</span>
      </div>
    </div>
    <ol class="dock-log">
      <li><span>01</span><code>WT e2-e4</code></li>
      <li><span>02</span><code>RD matrix +P1</code></li>
      <li><span>03</span><code>NV ... pending</code></li>
    </ol>
  </section>

  <!--
  <section class="ui-panel tactical-dock__panel">
    <div class="panel-heading">
      <p class="eyebrow">Inspector</p>
      <h2>Rule helper</h2>
    </div>
    <p class="dock-copy">
      Hover or focus controls to reveal mechanics. Color is always paired with a
      two-letter code and tactile pattern.
    </p>
  </section>
  -->
</aside>

<style>
  .tactical-dock {
    display: grid;
    align-content: start;
    gap: 8px;
    min-width: 0;
  }

  .tactical-dock__panel {
    padding: 12px;
  }

  .panel-heading {
    margin-bottom: 10px;
  }

  .panel-heading--row {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 12px;
  }

  .panel-heading h2 {
    margin: 0;
    font-size: 16px;
    letter-spacing: -0.01em;
  }

  .dock-filters {
    display: inline-flex;
    gap: 4px;
  }

  .dock-filters span {
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 3px 5px;
    background: var(--card);
    font: 700 10px/1 var(--font-mono);
  }

  .dock-log {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    font: 12px/1.35 var(--font-mono);
  }

  .dock-log li {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 8px;
    padding: 7px 8px;
    background: var(--card);
  }

  .dock-log span,
  .dock-copy {
    color: var(--muted);
  }

  .dock-copy {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
  }
</style>
